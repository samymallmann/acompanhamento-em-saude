{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Checagem estrita: é o que faz o TypeScript valer a pena.
       Sem isso, `undefined` passa despercebido e o erro só aparece em produção. */
    "strict": true,
    "noUncheckedIndexedAccess": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Espelha o alias definido em vite.config.ts.
       Sem "baseUrl": o TypeScript 6 o depreciou; sem ele, os caminhos abaixo
       são resolvidos em relação à pasta deste tsconfig, que é o que queremos. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
